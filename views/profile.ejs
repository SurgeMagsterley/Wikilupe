<%- include('partials/head') %>

<section class="profile-header panel">
  <div class="profile-main">
    <div class="profile-avatar">
      <% if (user.avatar) { %>
        <img src="<%= getImageUrl(user.avatar) %>" alt="Foto de perfil de <%= user.username %>">
      <% } else { %>
        <span><%= initials(user.username) %></span>
      <% } %>
    </div>

    <div class="profile-info">
      <span class="eyebrow">Mi perfil</span>
      <h1><%= user.username %></h1>
      <div class="profile-badges">
        <% if (user.is_admin) { %><span class="badge badge-admin">Superadmin</span><% } %>
        <span class="badge">Miembro desde <%= formatDate(user.created_at) %></span>
      </div>
      <p class="muted">Aquí administras tu foto de perfil, tu contraseña y todos tus personajes vinculados.</p>
    </div>
  </div>

  <div class="profile-actions">
    <a class="btn btn-primary" href="/personajes/nuevo">+ Subir personaje</a>
    <a class="btn btn-ghost" href="/usuarios/<%= encodeURIComponent(user.username) %>">Ver mi perfil público</a>
  </div>
</section>

<div class="profile-stats">
  <div class="mini-stat"><strong><%= characters.length %></strong><span>Personajes</span></div>
  <div class="mini-stat"><strong><%= totalPhotos %></strong><span>Fotos subidas</span></div>
  <div class="mini-stat"><strong>15</strong><span>Días de sesión</span></div>
</div>

<div class="profile-grid">
  <section class="panel">
    <h2>Foto de perfil</h2>
    <p class="muted">Se muestra en tu perfil. Formatos JPG, PNG, WEBP o GIF de hasta 4 MB.</p>

    <form action="/perfil/avatar" method="POST" enctype="multipart/form-data" class="stack">
      <label class="file-drop">
        <span>Elegir imagen</span>
        <input type="file" name="avatar" accept="image/jpeg,image/png,image/webp,image/gif" required>
        <small>La imagen se reemplaza si ya tenías una.</small>
      </label>

      <button type="submit" class="btn btn-secondary">Actualizar foto</button>
    </form>
  </section>

  <section class="panel" id="seguridad">
    <h2>Cambiar contraseña</h2>
    <p class="muted">Si no recuerdas la actual, la administración puede cambiarla manualmente desde el panel de superadmin.</p>

    <form action="/perfil/password" method="POST" class="stack">
      <label>
        Contraseña actual
        <input type="password" name="current_password" maxlength="72" autocomplete="current-password" required>
      </label>

      <div class="form-grid">
        <label>
          Contraseña nueva
          <input type="password" name="new_password" minlength="6" maxlength="72" autocomplete="new-password" required>
        </label>
        <label>
          Repetir nueva
          <input type="password" name="confirm_password" minlength="6" maxlength="72" autocomplete="new-password" required>
        </label>
      </div>

      <button type="submit" class="btn btn-secondary">Cambiar contraseña</button>
    </form>
  </section>
</div>

<section class="panel profile-featured" id="destacados">
  <div class="section-heading compact-heading">
    <div>
      <span class="eyebrow">Escaparate del perfil</span>
      <h2>Personajes destacados</h2>
    </div>
    <span class="badge">Hasta 3</span>
  </div>

  <p class="muted">
    Elige tus 3 personajes favoritos. Aparecerán destacados en tu perfil y en la lista de
    <a href="/usuarios">Perfiles</a> de la comunidad.
  </p>

  <% if (characters.length) { %>
    <form action="/perfil/destacados" method="POST" class="featured-form">
      <div class="featured-slots">
        <% for (let position = 1; position <= 3; position += 1) { %>
          <% const current = characters.find((character) => Number(character.featured_rank) === position); %>
          <label>
            <span class="featured-slot-number">#<%= position %></span>
            <select name="featured_<%= position %>">
              <option value="">— Sin elegir —</option>
              <% characters.forEach((character) => { %>
                <option value="<%= character.id %>" <%= current && current.id === character.id ? 'selected' : '' %>>
                  <%= character.name %>
                </option>
              <% }) %>
            </select>
          </label>
        <% } %>
      </div>

      <div class="form-actions form-actions-inline">
        <button type="submit" class="btn btn-secondary">Guardar destacados</button>
        <small class="hint">Si no eliges ninguno, se muestran tus 3 personajes más recientes.</small>
      </div>
    </form>

    <%
      const chosenFeatured = characters
        .filter((character) => character.featured_rank)
        .sort((a, b) => Number(a.featured_rank) - Number(b.featured_rank));
      const featuredShowcase = chosenFeatured.length ? chosenFeatured : characters.slice(0, 3);
    %>

    <% if (featuredShowcase.length) { %>
      <div class="user-featured profile-featured-preview">
        <div class="user-featured-heading">
          <span class="eyebrow">Así se ven ahora</span>
          <span class="muted small"><%= chosenFeatured.length ? 'Tus elecciones' : 'Más recientes (sin elección)' %></span>
        </div>

        <div class="user-featured-grid">
          <% featuredShowcase.forEach((character) => { %>
            <a class="user-featured-card" href="/personajes/<%= character.id %>">
              <div class="user-featured-cover" <%= character.bg_image ? 'style="background-image: url(' + getImageUrl(character.bg_image) + ')"' : '' %>>
                <% if (character.cover) { %>
                  <img src="<%= getImageUrl(character.cover) %>" alt="Foto de <%= character.name %>" loading="lazy">
                <% } else { %>
                  <span class="user-featured-initials"><%= initials(character.name) %></span>
                <% } %>
              </div>
              <div class="user-featured-body">
                <strong><%= character.name %></strong>
                <span class="user-featured-meta"><%= elementInfo(character.element).emoji %> <%= character.element %> · <%= roleInfo(character.role).label %></span>
              </div>
            </a>
          <% }) %>
        </div>
      </div>
    <% } %>
  <% } else { %>
    <p class="muted small">Sube tu primer personaje para poder destacarlo.</p>
  <% } %>
</section>

<section class="section">
  <div class="section-heading">
    <div>
      <span class="eyebrow">Tus fichas</span>
      <h2>Personajes vinculados</h2>
    </div>
    <a href="/personajes/nuevo" class="link-arrow">Sumar otro &rarr;</a>
  </div>

  <% if (characters.length) { %>
    <div class="character-grid">
      <% characters.forEach((character) => { %>
        <%- include('partials/character-card', { character }) %>
      <% }) %>
    </div>
  <% } else { %>
    <div class="empty-state">
      <span class="empty-icon">🧬</span>
      <h3>Todavía no has creado ningún personaje</h3>
      <p>Sube tu primera ficha con fotos, elemento, estadísticas y relaciones.</p>
      <a class="btn btn-primary" href="/personajes/nuevo">Crear mi primer personaje</a>
    </div>
  <% } %>
</section>

<%- include('partials/footer') %>
