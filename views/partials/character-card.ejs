<%
  const cover = character.cover;
  const role = roleInfo(character.role);
  const element = elementInfo(character.element);
  const firstTitle = String(character.titles || '')
    .split(/\r?\n/)
    .map((title) => title.trim())
    .filter(Boolean)[0];
  const shortDescription = character.description
    ? (character.description.length > 135 ? character.description.slice(0, 135).trim() + '…' : character.description)
    : 'Sin descripción por ahora.';
  const cardBgImage = character.bg_image || '';
  const coverUrl = cover ? getImageUrl(cover) : '';
  const bgUrl = cardBgImage ? getImageUrl(cardBgImage) : '';
%>
<article class="character-card<%= cardBgImage ? ' has-card-bg' : '' %>">
  <a class="card-cover" href="/personajes/<%= character.id %>" aria-label="Ver la ficha de <%= character.name %>" <%= bgUrl ? 'style="background-image: url(' + bgUrl + ')"' : '' %>>
    <% if (coverUrl) { %>
      <img src="<%= coverUrl %>" alt="Foto de <%= character.name %>" loading="lazy">
    <% } else if (bgUrl) { %>
      <span class="cover-placeholder cover-placeholder-bg"><%= initials(character.name) %></span>
    <% } else { %>
      <span class="cover-placeholder"><%= initials(character.name) %></span>
    <% } %>
    <span class="role-badge role-<%= role.value %>"><%= role.label %></span>
  </a>

  <div class="card-body">
    <span class="element-chip"><%= element.emoji %> <%= element.name %></span>
    <h3><a href="/personajes/<%= character.id %>"><%= character.name %></a></h3>
    <% if (firstTitle) { %>
      <span class="card-title"><%= firstTitle %></span>
    <% } %>
    <p class="card-owner">
      por <a href="/usuarios/<%= encodeURIComponent(character.username) %>">@<%= character.username %></a>
    </p>
    <p class="card-description"><%= shortDescription %></p>
  </div>
</article>
